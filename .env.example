# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and never committed.

# --- One database -----------------------------------------------------------
# Its endpoints are served at the root: /tables, /tables/{table}, /query ...
#
# Name of an ODBC DSN configured on this machine.
ODBC_DSN=
# Only if the DSN needs a login:
ODBC_UID=
ODBC_PWD=

# Or, instead of the three lines above, a full ODBC connection string:
# ODBC_CONN=Driver={PostgreSQL Unicode};Server=localhost;Database=shop;UID=me;PWD=secret;

# Optional:
# ODBC_PAGING=auto        auto | limit | offset_fetch | client  (see README)
# ODBC_HEALTH_SQL=        Statement the health check runs, e.g. SELECT 1.
#                         Blank = a successful connection is enough.

# --- Several databases ------------------------------------------------------
# List their names; each is served under /<name>/... and reads the same
# settings as above from variables prefixed with its upper-cased name.
# When DATABASES is set, the un-prefixed ODBC_* variables are ignored.
#
# DATABASES=sales,warehouse
# SALES_ODBC_DSN=SalesDsn
# WAREHOUSE_ODBC_CONN=Driver={ODBC Driver 18 for SQL Server};Server=db;Database=wh;UID=me;PWD=secret;
# WAREHOUSE_ODBC_PAGING=offset_fetch

# --- API keys ---------------------------------------------------------------
# Read-only key sent in the X-Api-Key header. REQUIRED.
# It can list, filter and look up rows; through /query it may run a single SELECT only.
# The app refuses to start if this is blank — there is no "auth disabled" mode.
# Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Optional separate key for reads + writes and unrestricted /query.
# Generate independently using the command above. Must differ from API_KEY.
# Leave blank to disable every write-capable operation.
WRITE_API_KEY=

# --- Optional ---------------------------------------------------------------
# Mount DELETE /tables/{table}/{pk_value} (write key required). Default: false.
# ALLOW_DELETE=false

# Browser origins allowed to call the API, comma-separated. Default: none —
# no web page can call the API from a browser until you list its origin here.
# Server-side callers (curl, scripts, backends) are not affected by CORS.
# Use * to allow any origin (not recommended).
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# LOG_LEVEL=INFO          DEBUG | INFO | WARNING | ERROR
# LOG_FORMAT=text         text | json
